{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "API Specbook",
  "version": "0.2.1",
  "identifier": "io.github.iskim1018.specbook",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "API Specbook",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iskim1018/api-specbook/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4OERBQTlGOUU1MzdFNDkKUldSSmZsT2VuNnFOT0dYSFZaSlhESk1kUlJaRmV3WS95VU9KbU9VZDYwSTJBb0FzOVFNcmZYWmgK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
