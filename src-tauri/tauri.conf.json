{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "API Specbook",
  "version": "0.1.0",
  "identifier": "io.github.iskim1018.specbook",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "API Specbook",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: Prompt Technology, Co., Ltd. (P4S6KATL7C)",
      "minimumSystemVersion": "10.15"
    }
  }
}
